{
  "title": "Retail Sales Overview",
  "fact_table": "Fact_Sales",
  "currency": "$",
  "date": {"name": "Order Date", "start": "2023-01-01", "end": "2023-12-31"},
  "dimensions": [
    {"name": "Region", "values": ["North", "South", "East", "West"]},
    {"name": "Category", "values": ["Technology", "Furniture", "Office Supplies"]},
    {"name": "Product", "parent": "Category",
     "values": ["Laptop", "Phone", "Chair", "Desk", "Paper", "Pens"],
     "parent_map": {"Laptop": "Technology", "Phone": "Technology", "Chair": "Furniture",
                    "Desk": "Furniture", "Paper": "Office Supplies", "Pens": "Office Supplies"}},
    {"name": "Customer", "values": ["Acme", "Globex"], "cardinality": 400}
  ],
  "id_columns": [{"name": "OrderID"}],
  "fact_columns": [
    {"name": "Sales", "kind": "money"},
    {"name": "Cost", "kind": "money", "derived_from": "Sales", "derived_ratio": 0.7},
    {"name": "Quantity", "kind": "quantity"},
    {"name": "Discount", "kind": "rate", "min": 0, "max": 0.5}
  ],
  "measures": [
    {"name": "Total Sales", "kind": "agg", "agg": "SUM", "column": "Sales", "format": "currency"},
    {"name": "Total Cost", "kind": "agg", "agg": "SUM", "column": "Cost", "format": "currency"},
    {"name": "Total Profit", "kind": "diff", "left": "Total Sales", "right": "Total Cost", "format": "currency"},
    {"name": "Profit Margin", "kind": "ratio", "num": "Total Profit", "den": "Total Sales", "format": "percent"},
    {"name": "Orders", "kind": "agg", "agg": "DISTINCTCOUNT", "column": "OrderID", "format": "number"},
    {"name": "Customers", "kind": "agg", "agg": "DISTINCTCOUNT", "column": "Customer", "format": "number"},
    {"name": "Units Sold", "kind": "agg", "agg": "SUM", "column": "Quantity", "format": "number"},
    {"name": "Avg Discount", "kind": "agg", "agg": "AVERAGE", "column": "Discount", "format": "percent"},
    {"name": "Avg Order Value", "kind": "ratio", "num": "Total Sales", "den": "Orders", "format": "currency"},
    {"name": "Tech Sales", "kind": "agg", "agg": "SUM", "column": "Sales", "format": "currency",
     "filters": [{"column": "Category", "value": "Technology"}]}
  ],
  "targets": [
    {"measure": "Total Sales", "value": 1200000, "source": "kpi", "label": "Total Sales"},
    {"measure": "Profit Margin", "value": 0.23, "source": "kpi", "label": "Profit Margin"},
    {"measure": "Orders", "value": 1500, "source": "kpi", "label": "Orders"},
    {"measure": "Customers", "value": 400, "source": "kpi", "label": "Customers"},
    {"measure": "Units Sold", "value": 9800, "source": "kpi", "label": "Units Sold"},
    {"measure": "Avg Discount", "value": 0.11, "source": "kpi", "label": "Avg Discount"},
    {"measure": "Total Sales", "value": 400000, "source": "chart", "label": "Sales by Region", "filters": [{"column": "Region", "value": "North"}]},
    {"measure": "Total Sales", "value": 300000, "source": "chart", "label": "Sales by Region", "filters": [{"column": "Region", "value": "South"}]},
    {"measure": "Total Sales", "value": 280000, "source": "chart", "label": "Sales by Region", "filters": [{"column": "Region", "value": "East"}]},
    {"measure": "Total Sales", "value": 220000, "source": "chart", "label": "Sales by Region", "filters": [{"column": "Region", "value": "West"}]},
    {"measure": "Total Sales", "value": 600000, "source": "chart", "label": "Sales by Category", "filters": [{"column": "Category", "value": "Technology"}]},
    {"measure": "Total Sales", "value": 350000, "source": "chart", "label": "Sales by Category", "filters": [{"column": "Category", "value": "Furniture"}]},
    {"measure": "Total Sales", "value": 250000, "source": "chart", "label": "Sales by Category", "filters": [{"column": "Category", "value": "Office Supplies"}]},
    {"measure": "Profit Margin", "value": 0.30, "source": "chart", "label": "Margin by Region", "filters": [{"column": "Region", "value": "North"}]},
    {"measure": "Profit Margin", "value": 0.18, "source": "chart", "label": "Margin by Region", "filters": [{"column": "Region", "value": "West"}]},
    {"measure": "Total Sales", "value": 80000, "source": "chart", "label": "Sales by Month", "filters": [{"column": "Month", "value": "Jan"}]},
    {"measure": "Total Sales", "value": 90000, "source": "chart", "label": "Sales by Month", "filters": [{"column": "Month", "value": "Feb"}]},
    {"measure": "Total Sales", "value": 100000, "source": "chart", "label": "Sales by Month", "filters": [{"column": "Month", "value": "Mar"}]},
